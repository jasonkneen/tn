{
  "name": "tn",
  "description": "Appcelerator & Titanium CLI wrapper to save you keystrokes.",
  "keywords": [
    "appcelerator",
    "titanium",
    "mobile",
    "ios",
    "iphone",
    "android",
    "alloy",
    "cli"
  ],
  "version": "5.4.1",
  "author": {
    "name": "Fokke Zandbergen",
    "email": "mail@fokkezb.nl"
  },
  "maintainers": [
    {
      "name": "Jason Kneen",
      "email": "jason@bouncingfish.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/jasonkneen/tn.git"
  },
  "preferGlobal": true,
  "dependencies": {
    "@inquirer/prompts": "^7.8.4",
    "chalk": "^4.1.2",
    "lodash": "^4.17.21",
    "update-notifier": "^7.3.1"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3"
  },
  "license": "Apache-2.0",
  "bin": "./bin/cli.js",
  "main": "./main.js",
  "scripts": {
    "postinstall": "node bin/cli.js uninstall",
    "test": "jest",
    "lint": "eslint lib/ bin/ *.js",
    "lint:fix": "eslint lib/ bin/ *.js --fix",
    "format": "prettier --write lib/ bin/ *.js *.md",
    "format:check": "prettier --check lib/ bin/ *.js *.md"
  },
  "directories": {
    "lib": "./lib"
  },
  "engines": {
    "node": ">=18"
  },
  "homepage": "http://www.bouncingfish.com",
  "bugs": {
    "url": "https://github.com/jasonkneen/tn/issues"
  }
}
